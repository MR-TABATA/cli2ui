# Developer live-reload override (optional).
#
# End users do NOT need this — `docker compose up` pulls the published image.
# For development, copy this file to docker-compose.override.yml; Compose merges
# it automatically, builds from your working tree instead of pulling, and mounts
# the tree so code changes are picked up without rebuilding:
#
#     cp docker-compose.override.yml.example docker-compose.override.yml
#
services:
  app:
    # Build from this working tree rather than pulling the published image.
    build: .
    volumes:
      - .:/app
      # The mount above shadows /app, so the management DB goes back to the
      # project root (db.sqlite3, gitignored) — the pre-image default, and handy
      # when you want to inspect or delete it from the host.
      - /data
    environment:
      CLI2UI_DB_PATH: /app/db.sqlite3
